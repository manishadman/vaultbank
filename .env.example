# Copy to backend/.env for local development.
# Never commit real secrets. VaultBank simulates money only.
# These values match docker-compose.yml. Replace them for any shared host.

DATABASE_URL=postgresql://vaultbank:vaultbank@127.0.0.1:5432/vaultbank
TEST_DATABASE_URL=postgresql://vaultbank:vaultbank@127.0.0.1:5432/vaultbank_test
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
SEED_ADMIN_EMAIL=admin@vaultbank.demo
SEED_ADMIN_PASSWORD=ChangeMe-Admin-1!
SEED_DEMO_PASSWORD=Demo-Customer-1!
VITE_API_URL=/api/v1
